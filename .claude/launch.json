{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "api",
        "run",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "pages",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd web && VITE_STATIC=1 BASE_PATH=/SOUND_LAB/ npm run build && BASE_PATH=/SOUND_LAB/ npx vite preview --port 4173 --strictPort"
      ],
      "port": 4173
    }
  ]
}
